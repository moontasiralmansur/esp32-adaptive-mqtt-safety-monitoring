# mosquitto.conf.example
# =====================================================================
# Minimal Mosquitto configuration for the Adaptive MQTT Safety
# Monitoring project.
#
# This configuration enables anonymous, unencrypted access for
# local-only operation. Do NOT expose this broker to an untrusted
# network.
#
# The implemented project does NOT use authentication, TLS,
# persistence, or bridges. Those features are intentionally absent.
#
# Reference implementation (source of truth):
#   - firmware/env-node/env-node.ino
#   - firmware/sec-node/sec-node.ino

# ---------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------

# Server bind/listen address for the Mosquitto broker.
# 0.0.0.0 means Mosquitto listens on all available network interfaces.
# Replace with a specific interface IP if you want to restrict access.
# This is a server address, not a client destination address.
# listener <port> [<bind address>]
listener 1883 0.0.0.0

# No accounts, tokens, or passwords are configured anywhere in this
# project. Anonymous connections are required for the ESP32
# publish-only clients to connect.
allow_anonymous true

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------

# Log to the console for visibility during operation.
log_dest stdout
log_type all